NODE_ENV=development
PORT=3001

# Pooled connection (used at runtime via pgbouncer)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (used for migrations only)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres"

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

SQUAD_SECRET_KEY=sk_your_secret_key
SQUAD_PUBLIC_KEY=pk_your_public_key
SQUAD_REDIRECT_URL=https://yourdomain.com/redirect
SQUAD_WEBHOOK_URL=https://yourdomain.com/webhook
SQUAD_ENV=sandbox